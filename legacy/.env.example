NODE_ENV=production
HOST=0.0.0.0
PORT=8080
PUBLIC_ORIGIN=https://emr.example.ke
TRUST_PROXY=true
DATA_DIR=/app/data
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
SEED_DEMO_DATA=false
# Prefer Docker/Kubernetes secret files over literal values.
EMR_BOOTSTRAP_PASSWORD_FILE=/run/secrets/emr_bootstrap_password
# Optional machine-integration credential, minimum 32 characters.
# EMR_API_KEY_FILE=/run/secrets/emr_api_key
