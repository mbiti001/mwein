# Mwein public website hardening — 23 September 2026.
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The previous backend is retired; the current EMR is hosted separately.
  RewriteRule ^backend(?:/|$) - [F,L,NC]
  # Keep ACME/AutoSSL validation available, deny other hidden paths.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  # Never serve development notes, dependency manifests or backup data.
  RewriteRule (^|/)(?:package(?:-lock)?\.json|composer\.(?:json|lock)|[^/]+\.(?:md|sql|sqlite3?|db|bak|zip|tar|tgz|gz|log))$ - [F,L,NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.mweinmedical\.co\.ke$ [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?mweinmedical\.co\.ke$ [NC]
  RewriteRule ^ https://mweinmedical.co.ke%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=2592000" "expr=%{HTTPS} == 'on'"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit


# Text compression where the host supports it. PHP no-store headers stay in control.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(?:common|home)\.[a-f0-9]{12}\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Careers is managed through the website dashboard.
RedirectMatch 301 ^/careers\.html$ /careers.php

# Consolidate the duplicate homepage URL.
RedirectMatch 301 ^/index\.html$ /

# Preserve the destinations of legacy moved pages using HTTP redirects.
RedirectMatch 301 ^/(about|quality)\.html$ /
RedirectMatch 301 ^/blog\.html$ /blog.php
RedirectMatch 301 ^/donations\.html$ /partners.html
RedirectMatch 301 ^/(appointments|shop|terms-of-service)\.html$ /contact.html
RedirectMatch 301 ^/patient-rights\.html$ /privacy-policy.html

# Block retired application trees and local development/runtime material.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^my-folder-name(?:/|$) - [F,L,NC]
  RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK)$ [NC]
  RewriteRule ^ - [F,L]
</IfModule>
<FilesMatch "(?i)^(?:\.env(?:\..*)?|error_log|.*\.(?:ini|bak|orig|save|swp|sql|sqlite3?|db|log))$">
  Require all denied
</FilesMatch>
