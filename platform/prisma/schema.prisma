  visit                  Visit     @relation(fields: [visitId], references: [id], onDelete: Restrict)
  requestedBy            User      @relation("AiGenerationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy             User?     @relation("AiGenerationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([facilityId, createdAt])
  @@index([visitId, createdAt])
  @@index([requestedById, status, createdAt])
}

model GovernanceEvidence {
  id                String    @id @default(uuid()) @db.Uuid
  facilityId        String    @db.Uuid
  gateCode          String
  status            String    @default("PENDING")
  owner             String
  evidenceReference String?
  notes             String?
  approvedAt        DateTime?
  reviewDueAt       DateTime?
  updatedById       String    @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  updatedBy         User      @relation("GovernanceEvidenceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([facilityId, gateCode])
  @@index([facilityId, status, reviewDueAt])
}
