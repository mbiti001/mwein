generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum SexAtBirth {
  FEMALE
  MALE
  INTERSEX
  UNKNOWN
}

enum VisitStatus {
  REGISTERED
  AWAITING_TRIAGE
  AWAITING_CLINICIAN
  UNDER_CONSULTATION
  ORDERS_PENDING
  AWAITING_RESULTS
  AWAITING_PHARMACY
  AWAITING_PAYMENT
  ADMITTED
  REFERRED
  DISCHARGED
  COMPLETED
  CANCELLED
}

enum Priority {
  ROUTINE
  PRIORITY
  URGENT
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  TRANSFERRED
  COMPLETED
  CANCELLED
}

enum EncounterStatus {
  DRAFT
  SIGNED
  CORRECTED
}

enum OrderType {
  LABORATORY
  IMAGING
  MEDICATION
  PROCEDURE
}

enum OrderStatus {
  DRAFT
  REQUESTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  READY
  PART_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK
  SHA
  INSURER
  EMPLOYER
  WAIVER
  CREDIT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
  REFUNDED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CatalogCategory {
  LABORATORY_TEST
  PROCEDURE
  PHARMACEUTICAL
  NON_PHARMACEUTICAL
}

model Facility {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  name                  String
  timezone              String                 @default("Africa/Nairobi")
  users                 User[]
  patients              Patient[]
  visits                Visit[]
  sequences             ReferenceSequence[]
  catalogItems          CatalogItem[]
  appointments          Appointment[]
  suppliers             Supplier[]
  stores                Store[]
  purchaseOrders        PurchaseOrder[]
  stocktakes            Stocktake[]
  accountingJournals    AccountingJournal[]
  referrals             Referral[]
  auditEvents           AuditEvent[]
  auditChainHead        AuditChainHead?
  loginThrottles        LoginThrottle[]
  governanceEvidence    GovernanceEvidence[]
  patientProblems       PatientProblem[]
  servicePointControls  ServicePointControl[]
  medicationSafetyRules MedicationSafetyRule[]
  externalIdentities    ExternalIdentity[]
  identityRoleMappings  IdentityRoleMapping[]
  aiGenerations         AiGeneration[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model CatalogItem {
  id                  String              @id @default(uuid()) @db.Uuid
  facilityId          String              @db.Uuid
  category            CatalogCategory
  code                String
  name                String
  description         String?
  unitPrice           Decimal             @db.Decimal(14, 2)
  costPrice           Decimal?            @db.Decimal(14, 2)
  packSize            Decimal?            @db.Decimal(12, 3)
  currency            String              @default("KES")
  active              Boolean             @default(true)
  specimenType        String?
  synonyms            String?
  loincCode           String?
  department          String?
  panelOrSingle       String?
  container           String?
  method              String?
  turnaroundMinutes   Int?
  reportableToKhis    Boolean             @default(false)
  khisMapping         String?
  modality            String?
  genericName         String?
  medicationConceptId String?
  therapeuticClass    String?
  strength            String?
  dosageForm          String?
  unitOfMeasure       String?
  reorderLevel        Decimal?            @db.Decimal(12, 3)
  facility            Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  referenceRanges     LabReferenceRange[]
  inventoryBatches    InventoryBatch[]
  prescriptions       Prescription[]
  dispensations       Dispensation[]      @relation("DispensedCatalogItem")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([facilityId, code])
  @@index([facilityId, category, active])
}

model LabReferenceRange {
  id                String      @id @default(uuid()) @db.Uuid
  catalogItemId     String      @db.Uuid
  analyte           String
  componentCode     String?
  loincCode         String?
  unit              String?
  unitUcum          String?
  displayOrder      Int         @default(0)
  sexAtBirth        String      @default("ANY")
  minAgeDays        Int?
  maxAgeDays        Int?
  lowerLimit        Decimal?    @db.Decimal(18, 6)
  upperLimit        Decimal?    @db.Decimal(18, 6)
  criticalLow       Decimal?    @db.Decimal(18, 6)
  criticalHigh      Decimal?    @db.Decimal(18, 6)
  qualitativeValues String?
  method            String?
  analyser          String?
  pregnancyStage    String?
  approvedBy        String?
  source            String?
  active            Boolean     @default(true)
  verifiedAt        DateTime?
  catalogItem       CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([catalogItemId, active])
}

model ReferenceSequence {
  id         String   @id @default(uuid()) @db.Uuid
  facilityId String   @db.Uuid
  kind       String
  year       Int
  nextValue  BigInt   @default(1)
  facility   Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, kind, year])
}

model User {
  id                          String                     @id @default(uuid()) @db.Uuid
  facilityId                  String                     @db.Uuid
  email                       String
  displayName                 String
  passwordHash                String
  status                      UserStatus                 @default(ACTIVE)
  mustChangePassword          Boolean                    @default(true)
  passwordChangedAt           DateTime?
  lastLoginAt                 DateTime?
  facility                    Facility                   @relation(fields: [facilityId], references: [id])
  roles                       UserRole[]
  sessions                    Session[]
  encounters                  Encounter[]
  clinicalOrders              ClinicalOrder[]
  recordedLabResults          LaboratoryResult[]         @relation("LabResultRecordedBy")
  verifiedLabResults          LaboratoryResult[]         @relation("LabResultVerifiedBy")
  dispensedPrescriptions      Prescription[]             @relation("PrescriptionDispensedBy")
  performedImagingResults     ImagingResult[]            @relation("ImagingPerformedBy")
  verifiedImagingResults      ImagingResult[]            @relation("ImagingVerifiedBy")
  stockMovements              StockMovement[]
  dispensations               Dispensation[]
  medicationSafetyOverrides   MedicationSafetyOverride[]
  encounterAddenda            EncounterAddendum[]
  updatedServicePointRecords  ServicePointRecord[]
  createdReferrals            Referral[]                 @relation("ReferralCreatedBy")
  updatedReferrals            Referral[]                 @relation("ReferralUpdatedBy")
  referralAttachments         ReferralAttachment[]       @relation("ReferralAttachmentAddedBy")
  referralAcknowledgements    ReferralAcknowledgement[]  @relation("ReferralAcknowledgementRecordedBy")
  createdPatientRelationships PatientRelationship[]
  createdClaims               Claim[]
  reversedPayments            Payment[]                  @relation("PaymentReversedBy")
  openedStocktakes            Stocktake[]                @relation("StocktakeOpenedBy")
  submittedStocktakes         Stocktake[]                @relation("StocktakeSubmittedBy")
  approvedStocktakes          Stocktake[]                @relation("StocktakeApprovedBy")
  countedStocktakeLines       StocktakeLine[]            @relation("StocktakeLineCountedBy")
  accountingJournals          AccountingJournal[]        @relation("AccountingJournalPostedBy")
  auditEvents                 AuditEvent[]
  recordedPatientProblems     PatientProblem[]           @relation("PatientProblemRecordedBy")
  updatedGovernanceEvidence   GovernanceEvidence[]       @relation("GovernanceEvidenceUpdatedBy")
  updatedServicePointControls ServicePointControl[]      @relation("ServicePointControlUpdatedBy")
  preparedReminderDeliveries  ReminderDelivery[]         @relation("ReminderDeliveryPreparedBy")
  receivedPayments            Payment[]                  @relation("PaymentReceivedBy")
  approvedMedicationRules     MedicationSafetyRule[]     @relation("MedicationSafetyRuleApprovedBy")
  externalIdentities          ExternalIdentity[]
  updatedIdentityRoleMappings IdentityRoleMapping[]      @relation("IdentityRoleMappingUpdatedBy")
  requestedAiGenerations      AiGeneration[]             @relation("AiGenerationRequestedBy")
  reviewedAiGenerations       AiGeneration[]             @relation("AiGenerationReviewedBy")
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@unique([facilityId, email])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  system      Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  ipHash     String?
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model LoginThrottle {
  key             String    @id
  facilityId      String?   @db.Uuid
  emailHash       String
  ipHash          String
  failedCount     Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
  facility        Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, updatedAt])
}

model Patient {
  id                String                @id @default(uuid()) @db.Uuid
  facilityId        String                @db.Uuid
  patientNumber     String
  givenName         String?
  middleName        String?
  familyName        String?
  fullName          String
  normalizedName    String
  dateOfBirth       DateTime?             @db.Date
  estimatedAgeYears Int?
  sexAtBirth        SexAtBirth
  gender            String?
  bloodGroup        String?
  occupation        String?
  maritalStatus     String?
  disabilityStatus  String?
  preferredLanguage String                @default("English")
  restricted        Boolean               @default(false)
  active            Boolean               @default(true)
  facility          Facility              @relation(fields: [facilityId], references: [id])
  identifiers       PatientIdentifier[]
  contacts          PatientContact[]
  addresses         PatientAddress[]
  consents          Consent[]
  allergies         Allergy[]
  visits            Visit[]
  invoices          Invoice[]
  appointments      Appointment[]
  referrals         Referral[]
  relationshipsFrom PatientRelationship[] @relation("PatientRelationshipSource")
  relationshipsTo   PatientRelationship[] @relation("PatientRelationshipTarget")
  problems          PatientProblem[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([facilityId, patientNumber])
  @@index([facilityId, normalizedName])
}

model PatientProblem {
  id             String    @id @default(uuid()) @db.Uuid
  facilityId     String    @db.Uuid
  patientId      String    @db.Uuid
  codeSystem     String    @default("ICD-11 MMS")
  code           String?
  foundationUri  String?
  description    String
  clinicalStatus String    @default("ACTIVE")
  onsetDate      DateTime? @db.Date
  resolvedAt     DateTime?
  notes          String?
  recordedById   String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  facility       Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy     User      @relation("PatientProblemRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([facilityId, patientId, clinicalStatus])
  @@index([patientId, updatedAt])
}

model PatientIdentifier {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  type      String
  value     String
  issuer    String?
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, value])
}

model PatientContact {
  id           String  @id @default(uuid()) @db.Uuid
  patientId    String  @db.Uuid
  type         String
  value        String
  relationship String?
  primary      Boolean @default(false)
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([value])
}

model PatientAddress {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  county    String
  subcounty String
  ward      String?
  village   String?
  address   String?
  primary   Boolean @default(true)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Consent {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid
  type         String
  granted      Boolean
  recordedById String    @db.Uuid
  recordedAt   DateTime  @default(now())
  withdrawnAt  DateTime?
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Allergy {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  substance String
  reaction  String?
  severity  String?
  active    Boolean @default(true)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Visit {
  id            String          @id @default(uuid()) @db.Uuid
  facilityId    String          @db.Uuid
  patientId     String          @db.Uuid
  appointmentId String?         @unique @db.Uuid
  visitNumber   String
  clinic        String
  visitType     String
  priority      Priority        @default(ROUTINE)
  status        VisitStatus     @default(REGISTERED)
  reason        String
  arrivedAt     DateTime        @default(now())
  completedAt   DateTime?
  facility      Facility        @relation(fields: [facilityId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id])
  queues        QueueEntry[]
  triage        TriageRecord?
  encounters    Encounter[]
  orders        ClinicalOrder[]
  invoice       Invoice?
  referrals     Referral[]
  aiGenerations AiGeneration[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([facilityId, visitNumber])
  @@index([facilityId, status, priority, arrivedAt])
}

model Appointment {
  id                 String             @id @default(uuid()) @db.Uuid
  facilityId         String             @db.Uuid
  patientId          String             @db.Uuid
  scheduledAt        DateTime
  clinic             String
  status             AppointmentStatus  @default(SCHEDULED)
  notes              String?
  reminderPreparedAt DateTime?
  facility           Facility           @relation(fields: [facilityId], references: [id])
  patient            Patient            @relation(fields: [patientId], references: [id])
  visit              Visit?
  reminderDeliveries ReminderDelivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([facilityId, patientId, scheduledAt])
  @@index([facilityId, status, scheduledAt])
}

model ReminderDelivery {
  id                String      @id @default(uuid()) @db.Uuid
  appointmentId     String      @db.Uuid
  preparedById      String      @db.Uuid
  channel           String      @default("MANUAL")
  destinationMasked String
  messageHash       String
  status            String      @default("PREPARED")
  providerReference String?
  failureReason     String?
  preparedAt        DateTime    @default(now())
  sentAt            DateTime?
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  preparedBy        User        @relation("ReminderDeliveryPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)

  @@index([appointmentId, preparedAt])
  @@index([status, preparedAt])
}

model QueueEntry {
  id           String      @id @default(uuid()) @db.Uuid
  visitId      String      @db.Uuid
  servicePoint String
  priority     Priority
  status       QueueStatus @default(WAITING)
  enteredAt    DateTime    @default(now())
  calledAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  visit        Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([servicePoint, status, priority, enteredAt])
}

model ServicePointControl {
  id           String    @id @default(uuid()) @db.Uuid
  facilityId   String    @db.Uuid
  servicePoint String
  paused       Boolean   @default(false)
  pauseReason  String?
  pausedAt     DateTime?
  updatedById  String    @db.Uuid
  facility     Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  updatedBy    User      @relation("ServicePointControlUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([facilityId, servicePoint])
  @@index([facilityId, paused])
}

model TriageRecord {
  id                  String        @id @default(uuid()) @db.Uuid
  visitId             String        @unique @db.Uuid
  chiefComplaint      String
  triageCategory      Priority
  notes               String?
  pregnancyStatus     String?
  lastMenstrualPeriod DateTime?     @db.Date
  visit               Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  observations        Observation[]
  completedAt         DateTime?
}

model Observation {
  id           String       @id @default(uuid()) @db.Uuid
  triageId     String       @db.Uuid
  code         String
  valueDecimal Decimal?     @db.Decimal(12, 3)
  valueText    String?
  unit         String?
  abnormal     Boolean      @default(false)
  critical     Boolean      @default(false)
  triage       TriageRecord @relation(fields: [triageId], references: [id], onDelete: Cascade)
  recordedAt   DateTime     @default(now())

  @@index([triageId, code])
}

model Encounter {
  id                  String              @id @default(uuid()) @db.Uuid
  visitId             String              @db.Uuid
  clinicianId         String              @db.Uuid
  status              EncounterStatus     @default(DRAFT)
  noteFormat          String              @default("SOAP")
  subjective          String?
  objective           String?
  assessment          String?
  plan                String?
  signedAt            DateTime?
  correctsEncounterId String?             @db.Uuid
  visit               Visit               @relation(fields: [visitId], references: [id])
  clinician           User                @relation(fields: [clinicianId], references: [id])
  diagnoses           Diagnosis[]
  prescriptions       Prescription[]
  addenda             EncounterAddendum[]
  servicePointRecord  ServicePointRecord?
  referrals           Referral[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model ServicePointRecord {
  id              String    @id @default(uuid()) @db.Uuid
  encounterId     String    @unique @db.Uuid
  servicePoint    String
  templateVersion String
  data            Json
  riskLevel       String?
  followUpAt      DateTime? @db.Date
  updatedById     String    @db.Uuid
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  updatedBy       User      @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([servicePoint, followUpAt])
}

model PatientRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @db.Uuid
  relatedPatientId String   @db.Uuid
  relationship     String
  createdById      String   @db.Uuid
  patient          Patient  @relation("PatientRelationshipSource", fields: [patientId], references: [id], onDelete: Restrict)
  relatedPatient   Patient  @relation("PatientRelationshipTarget", fields: [relatedPatientId], references: [id], onDelete: Restrict)
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@unique([patientId, relatedPatientId, relationship])
  @@index([relatedPatientId, relationship])
}

model Referral {
  id                    String                    @id @default(uuid()) @db.Uuid
  facilityId            String                    @db.Uuid
  visitId               String                    @db.Uuid
  patientId             String                    @db.Uuid
  encounterId           String?                   @db.Uuid
  idempotencyKey        String                    @unique
  referralNumber        String
  type                  String
  referrerName          String
  referringFacility     String
  referringDepartment   String?
  reason                String
  clinicalSummary       String
  diagnosisSummary      String
  urgency               Priority                  @default(ROUTINE)
  legacyAttachedResults Json                      @default("[]") @map("attachedResults")
  receivingFacility     String
  receivingDepartment   String?
  appointmentAt         DateTime?
  status                String                    @default("DRAFT")
  feedback              String?
  createdById           String                    @db.Uuid
  updatedById           String                    @db.Uuid
  sentAt                DateTime?
  acceptedAt            DateTime?
  attendedAt            DateTime?
  returnedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  facility              Facility                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  visit                 Visit                     @relation(fields: [visitId], references: [id], onDelete: Restrict)
  patient               Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter             Encounter?                @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy             User                      @relation("ReferralCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                      @relation("ReferralUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  attachments           ReferralAttachment[]
  acknowledgements      ReferralAcknowledgement[]

  @@unique([facilityId, referralNumber])
  @@index([facilityId, status, createdAt])
  @@index([patientId, createdAt])
}

model ReferralAttachment {
  id                 String            @id @default(uuid()) @db.Uuid
  referralId         String            @db.Uuid
  sourceType         String
  laboratoryResultId String?           @db.Uuid
  imagingResultId    String?           @db.Uuid
  metadataVersion    Int               @default(1)
  metadata           Json
  attachedById       String            @db.Uuid
  attachedAt         DateTime          @default(now())
  referral           Referral          @relation(fields: [referralId], references: [id], onDelete: Restrict)
  laboratoryResult   LaboratoryResult? @relation(fields: [laboratoryResultId], references: [id], onDelete: Restrict)
  imagingResult      ImagingResult?    @relation(fields: [imagingResultId], references: [id], onDelete: Restrict)
  attachedBy         User              @relation("ReferralAttachmentAddedBy", fields: [attachedById], references: [id], onDelete: Restrict)

  @@unique([referralId, laboratoryResultId])
  @@unique([referralId, imagingResultId])
  @@index([laboratoryResultId])
  @@index([imagingResultId])
}

model ReferralAcknowledgement {
  id                 String   @id @default(uuid()) @db.Uuid
  referralId         String   @db.Uuid
  eventType          String
  referralStatus     String
  providerName       String
  providerRole       String?
  registrationNumber String?
  note               String?
  acknowledgedAt     DateTime
  recordedById       String   @db.Uuid
  recordedAt         DateTime @default(now())
  referral           Referral @relation(fields: [referralId], references: [id], onDelete: Restrict)
  recordedBy         User     @relation("ReferralAcknowledgementRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([referralId, acknowledgedAt])
}

model EncounterAddendum {
  id          String    @id @default(uuid()) @db.Uuid
  encounterId String    @db.Uuid
  authorId    String    @db.Uuid
  text        String
  reason      String
  createdAt   DateTime  @default(now())
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([encounterId, createdAt])
}

model Diagnosis {
  id            String         @id @default(uuid()) @db.Uuid
  encounterId   String         @db.Uuid
  type          String
  description   String
  icd10Code     String?
  codingSystem  String         @default("ICD-11 MMS")
  code          String?
  foundationUri String?
  primary       Boolean        @default(false)
  encounter     Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
}

model ClinicalOrder {
  id                 String           @id @default(uuid()) @db.Uuid
  visitId            String           @db.Uuid
  orderedById        String           @db.Uuid
  type               OrderType
  status             OrderStatus      @default(REQUESTED)
  priority           Priority         @default(ROUTINE)
  displayName        String
  clinicalIndication String?
  requestedAt        DateTime         @default(now())
  completedAt        DateTime?
  visit              Visit            @relation(fields: [visitId], references: [id])
  orderedBy          User             @relation(fields: [orderedById], references: [id])
  laboratory         LaboratoryOrder?
